{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wellness-air": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "wellness-air@0.7.3"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "AIRGRADIENT_API_TOKEN": "${AIRGRADIENT_API_TOKEN}",
        "AIRTHINGS_CLIENT_ID": "${AIRTHINGS_CLIENT_ID}",
        "AIRTHINGS_CLIENT_SECRET": "${AIRTHINGS_CLIENT_SECRET}",
        "PURPLEAIR_API_KEY": "${PURPLEAIR_API_KEY}"
      }
    }
  }
}
